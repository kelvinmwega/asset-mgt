// Prisma schema — asset-mgt
//
// Data shape per docs/intake/asset-mgt/SOLUTION.md. Two rules are load-bearing:
// - Person stores employeeRef (employee number), NEVER a national ID (brief §7.3).
// - AssetEvent is an append-only audit trail: no update/delete path may ever be
//   written against it; corrections are new events.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN_IT
  PROCUREMENT
  FINANCE
  STAFF_RO
}

// Lifecycle: ON_ORDER → IN_STOCK (tag assigned at delivery) ↔ ASSIGNED;
// {IN_STOCK, ASSIGNED} → IN_REPAIR → IN_STOCK; any → RETIRED.
// Transition validation is application logic (AM-02); the enum is the vocabulary.
enum AssetStatus {
  ON_ORDER
  IN_STOCK
  ASSIGNED
  IN_REPAIR
  RETIRED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DEFECTIVE
}

enum AssetEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  RETURNED
  IMPORTED
  CORRECTION
}

enum UserEventType {
  CREATED
  ROLE_CHANGED
  DEACTIVATED
  REACTIVATED
}

model Asset {
  id            String          @id @default(cuid())
  // Client's own numeric tag scheme: unique at the DB level, nullable until delivery.
  tag           String?         @unique
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id])
  // Nullable since AM-04: the client's legacy export leaves Brand and
  // Model blank on real rows and carries the whole of what an asset IS in
  // `description`. Deriving make from the description works for "HP …" and
  // INVENTS a manufacturer for everything else, unrecoverably; rejecting
  // blank-Brand rows would have quarantined most of the ~400-row cutover.
  // The register's own creation form still requires both — the nullability
  // serves imported history, not new data entry.
  //
  // Display precedence is stated ONCE, centrally, in `assetDisplayName`
  // (src/lib/asset-display.ts): make+model → else description → else tag.
  make          String?
  model         String?
  // The legacy export's identity line, and the only populated name on an imported
  // row. Searchable (src/lib/asset-search.ts) — without it `?q=` silently dies
  // at cutover, because make and model are blank on every imported asset.
  description   String?
  serial        String?
  purchasedAt   DateTime?
  purchasePrice Decimal?        @db.Decimal(12, 2)
  supplier      String?
  warrantyUntil DateTime?
  status        AssetStatus     @default(ON_ORDER)
  condition     AssetCondition?
  siteId        String?
  site          Site?           @relation(fields: [siteId], references: [id])
  // AM-04 export columns with a settled meaning. `PID` and `Asset Type` are
  // deliberately NOT here (AM-04-C4/C31): nobody can state what the code "CE"
  // means, and a column holding an unexplained value gets rendered, exported
  // and depended upon. They are decided from the full-export census instead.
  //
  // `location` is free text WITHIN a site (the export's Location column feeds
  // Site.name — AM-04-C17); costCentre and poNumber are the finance and
  // procurement handles AM-05's export will want.
  poNumber      String?
  costCentre    String?
  department    String?
  location      String?
  assignments   Assignment[]
  events        AssetEvent[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // The register list filters on these three (AM-02); AM-07's search adds its
  // own. A CHECK constraint the schema language cannot express lives in the
  // am02_asset_lifecycle migration: a tag is mandatory for every status except
  // ON_ORDER (not yet delivered) and RETIRED (may never have been tagged —
  // dead-on-arrival kit returned to the supplier).
  @@index([status])
  @@index([categoryId])
  @@index([siteId])
}

model Person {
  id          String       @id @default(cuid())
  name        String
  // Nullable since AM-04. A HOLDER IS NOT NECESSARILY A SYSTEM USER: login
  // identity is User.email, which stays required and unique. The schema already
  // agreed everywhere else — `user` is optional, and assertPersonAssignable
  // documents that a person with no User is fully assignable (contractors,
  // staff without logins). The legacy export has no email column at all,
  // so under the old shape an imported holder could not be created.
  //
  // NO SYNTHESIZED ADDRESS, EVER — no placeholder, no @…invalid (AM-04-C2). It
  // fabricates a personal datum, and two same-named people either collide on a
  // confusing P2002 or MERGE INTO ONE PERSON.
  //
  // A blank email must land as NULL, never '': Postgres permits many NULLs in a
  // unique index but exactly one '', so the second email-less person would
  // collide. Same trap as Asset.tag (am02 migration).
  //
  // The cost, accepted: this removes the dedupe key for exactly the rows the
  // import creates, which is why assignee resolution is exact-unique-or-nothing
  // with human sign-off (AM-04-C8/C9) rather than a fuzzy match.
  email       String?      @unique
  // Employee number — never a national ID (brief §7.3).
  employeeRef String?      @unique
  assignments Assignment[]
  user        User?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Assignment is a STATE row, not an audit row (AM-03 advisor ruling, and the
// rule is restated in CLAUDE.md). Exactly two columns are mutable —
// `returnedAt` and `conditionNotes` — set exactly ONCE, by the return path, on
// a row where `returnedAt IS NULL`. Every other column is write-once at insert,
// and Assignment rows are never deleted. The audit anchor is the
// ASSIGNED/RETURNED AssetEvent pair; AssetEvent and UserEvent remain
// append-only and this bounded exception does NOT extend to them.
//
// Two constraints the schema language cannot express live in the
// am03_assignment migration: a PARTIAL unique index giving each asset at most
// one open assignment (the AC-1 trust gate), and a CHECK that a return cannot
// predate its checkout.
model Assignment {
  id             String       @id @default(cuid())
  assetId        String
  asset          Asset        @relation(fields: [assetId], references: [id])
  personId       String
  person         Person       @relation(fields: [personId], references: [id])
  checkedOutAt   DateTime     @default(now())
  returnedAt     DateTime?
  conditionNotes String?
  events         AssetEvent[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([assetId])
  @@index([personId])
  // The per-person view ("everything X currently holds") and AM-07's search
  // both filter on exactly this pair.
  @@index([personId, returnedAt])
}

// Append-only audit trail. Rows are only ever inserted and read — never updated
// or deleted. Corrections are new CORRECTION events referencing the same asset.
model AssetEvent {
  id           String         @id @default(cuid())
  assetId      String
  asset        Asset          @relation(fields: [assetId], references: [id])
  type         AssetEventType
  fromStatus   AssetStatus?
  toStatus     AssetStatus?
  actorId      String?
  // Restrict, not SetNull: deleting a User must never silently blank audit
  // attribution (users are deactivated, never deleted). Matches UserEvent —
  // the advisor attached this as an AM-01 condition to apply the moment the
  // asset write path opened, which is this story.
  actor        User?          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  // Set on ASSIGNED and RETURNED events. This FK exists to keep PERSONAL DATA
  // OUT of this append-only table: without it, "who held it" could only be
  // recorded as free text in `notes`, putting a copy of a person's name into a
  // table that is never updated and never deleted — where a name change or a
  // DPA erasure request is unhonourable by construction. The link keeps exactly
  // one copy of the person reference (on Assignment) and the history renders by
  // join. Restrict matches actorId: nothing may silently blank attribution.
  //
  // Standing rule: no personal data — names, emails, employee refs — is ever
  // written into AssetEvent.notes or any UserEvent field.
  assignmentId String?
  assignment   Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  notes        String?
  at           DateTime       @default(now())

  @@index([assetId, at])
}

model Category {
  id     String  @id @default(cuid())
  name   String  @unique
  assets Asset[]
}

model Site {
  id     String  @id @default(cuid())
  name   String  @unique
  assets Asset[]
}

// A STATE row, not an audit row — the same bounded exception `Assignment`
// carries, and bounded the same way (AM-04-C5). It is written once at run
// start, updated EXACTLY ONCE at run end (counts, report, finishedAt), and
// never deleted. Nothing else may update it.
//
// NO PERSONAL DATA (AM-04-C6). `report` carries no name, no email, no
// employeeRef, and no verbatim echo of a source row. Rows are identified by
// source row number plus Asset Tag ID; people by `personId` only — the same
// join-don't-copy pattern AssetEvent.assignmentId exists to enforce.
//
// This is deliberate and it is the reason the export's "Created by" column is
// not imported ANYWHERE (AM-04-C7). Parking it here looked like the safe
// alternative to AssetEvent.notes, and is worse: a CODE-WRITTEN copy of staff
// names in a table with no role gate, no retention policy, and this codebase's
// blanket no-delete rule. Names appear only in the IN-FLIGHT dry-run report an
// operator reads and signs — a different artefact from this durable row.
//
// If this is ever surfaced in the app it is ADMIN_IT only, `requireRole` first
// statement. Holding the no-personal-data line now is what keeps that surface
// cheap later.
model ImportBatch {
  id           String    @id @default(cuid())
  source       String
  runAt        DateTime  @default(now())
  dryRun       Boolean
  // Written at run end, with the row created at run start — hence the defaults
  // and the nullable report.
  finishedAt   DateTime?
  rowsOk       Int       @default(0)
  rowsFailed   Int       @default(0)
  report       Json?
  // AM-04-C21: `--commit --batch=<id>` re-parses the file and recomputes BOTH
  // hashes, refusing on any difference. That is what makes "the committed data
  // is the previewed data" provable while keeping ZERO server-side parsed
  // state. sourceSha256 catches a swapped file; rowsHash catches a file that
  // differs only in ways the parser normalises away.
  sourceSha256 String
  rowsHash     String
}

// ---------------------------------------------------------------------------
// Auth.js (v5) models — standard @auth/prisma-adapter shape plus role/personId.
// Sessions are JWT (no Session rows at runtime); the table exists so the
// adapter surface stays complete if the strategy ever changes deliberately.
// Role is read from this table inside every mutating action (requireRole) —
// never trusted from the JWT.
// ---------------------------------------------------------------------------

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  role          Role         @default(STAFF_RO)
  // Deactivation is a flag, NEVER a delete — deleting a User would sever
  // AssetEvent actor attribution. Checked in both the signIn callback (blocks
  // new sessions) and requireRole (kills live JWT sessions at next request).
  deactivatedAt DateTime?
  personId      String?      @unique
  person        Person?      @relation(fields: [personId], references: [id])
  accounts      Account[]
  sessions      Session[]
  assetEvents   AssetEvent[]
  events        UserEvent[]  @relation("UserEventSubject")
  actedEvents   UserEvent[]  @relation("UserEventActor")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// Append-only audit trail (same rule as AssetEvent): rows are only ever
// inserted and read — no update/delete path may ever be written against it;
// corrections are new events. actorId null = system action (seed script).
model UserEvent {
  id       String        @id @default(cuid())
  userId   String
  user     User          @relation("UserEventSubject", fields: [userId], references: [id])
  // Restrict, not SetNull: deleting a User must never silently blank audit
  // attribution (users are deactivated, never deleted — advisor condition).
  actorId  String?
  actor    User?         @relation("UserEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  type     UserEventType
  fromRole Role?
  toRole   Role?
  at       DateTime      @default(now())

  @@index([userId, at])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  // Adapter inserts ignore this column (default fills it); it exists so the
  // sign-in throttle windows are computable (src/lib/sign-in-policy.ts).
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}
